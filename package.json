{
  "name": "discord.js-selfbot-v13",
  "version": "14.27.0",
  "type": "module",
  "description": "An unofficial discord.js v14 fork for creating selfbots and automating user accounts with full TypeScript support",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "all": "npm run build && npm publish",
    "test": "npm run typecheck",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "login:qr": "node examples/QRLogin.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write src/**/*.ts"
  },
  "files": [
    "dist",
    "src"
  ],
  "directories": {
    "lib": "src",
    "test": "test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/donyst/discord.js-selfbot-v13.git"
  },
  "keywords": [
    "discord.js",
    "discord.js v14",
    "discord.js v13",
    "selfbot",
    "selfbot v14",
    "selfbot v13",
    "djs",
    "api",
    "bot",
    "node",
    "discord",
    "client",
    "discordapp",
    "builders"
  ],
  "author": "Phạm Minh Đồng <dongdz.user@gmail.com> (https://github.com/donyst)",
  "contributors": [
    "aiko-chan-ai <https://github.com/aiko-chan-ai>",
    "discord.js team <https://github.com/discordjs/discord.js>"
  ],
  "license": "GNU General Public License v3.0",
  "bugs": {
    "url": "https://github.com/donyst/discord.js-selfbot-v13/issues"
  },
  "homepage": "https://github.com/donyst/discord.js-selfbot-v13#readme",
  "dependencies": {
    "@discordjs/builders": "^1.6.3",
    "@discordjs/collection": "^2.1.1",
    "@sapphire/async-queue": "^1.5.5",
    "@sapphire/shapeshift": "^4.0.0",
    "discord-api-types": "^0.38.15",
    "fetch-cookie": "^3.1.0",
    "find-process": "^2.0.0",
    "otplib": "^12.0.1",
    "prism-media": "^1.3.5",
    "qrcode": "^1.5.4",
    "tough-cookie": "^5.1.2",
    "tree-kill": "^1.2.2",
    "undici": "^7.11.0",
    "werift-rtp": "^0.8.4",
    "ws": "^8.16.0"
  },
  "engines": {
    "node": ">=20.18"
  },
  "devDependencies": {
    "@discordjs/docgen": "^0.11.1",
    "@types/debug": "^4.1.12",
    "@types/node": "^22.10.7",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.5.10",
    "dtslint": "^4.2.1",
    "eslint": "^8.39.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-prettier": "^4.2.1",
    "patch-package": "^8.0.0",
    "prettier": "^2.8.8",
    "tsd": "^0.32.0",
    "tslint": "^6.1.3",
    "typescript": "^7.0.2"
  }
}
